@page "/"
@using BlazorApp_WASM_WebScrapping_Youtube.Models

@inject YoutubeScrappingService _ytService;

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>


<div class="d-flex flex-wrap">

    @if (videos.Any())
    {
        @foreach (var item in videos)
        {
            <div class="m-2" style="width: 540px;">
                <VideoCard video="item" />
            </div>
        }
    }
    else
    {
        <span class="text-danger text-center">
            No hay videos para mostrar
        </span>
    }
</div>

@code {
    public List<Video> videos = new();


    protected override async Task OnInitializedAsync()
    {
        var result = await _ytService.GetPupularVideos();
        if (result.Any())
        {
            videos = result;
            Console.WriteLine("Todo ok, los registros se listaron"); ;
        }
        else
        {
            Console.WriteLine("No hay registros para mostrar");
        }
    }
}
